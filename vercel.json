{
  "outputDirectory": "dist",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "framework": null,
  "functions": {
    "api/program-page.ts": {
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "dist/index.html"
    },
    "api/og.ts": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/sitemap.ts": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/og/(.*)\\.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=600" },
        { "key": "Content-Type",  "value": "image/png" }
      ]
    }
  ],
  "redirects": [
    { "source": "/p/v5-mainnet/:id", "destination": "/programs/program-:id",           "permanent": true },
    { "source": "/p/v5-testnet/:id", "destination": "/testnet/programs/program-:id",    "permanent": true },
    { "source": "/p/v4-mainnet/:id", "destination": "/programs/v4/program-:id",         "permanent": true },
    { "source": "/p/v4-testnet/:id", "destination": "/testnet/programs/v4/program-:id", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml",             "destination": "/api/sitemap"      },
    { "source": "/programs/:path*",         "destination": "/api/program-page" },
    { "source": "/testnet/programs/:path*", "destination": "/api/program-page" },
    {
      "source": "/((?!assets/|og/|api/|_next/|robots\\.txt|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
